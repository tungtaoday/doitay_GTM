+            $table->string('channel', 16)->nullable();            // miniapp | web
+            $table->unsignedBigInteger('company_id')->nullable()->index(); // hồ sơ thợ liên quan
+            $table->string('actor_key', 191)->nullable()->index();// zalo_id / session ẩn danh (không PII)
